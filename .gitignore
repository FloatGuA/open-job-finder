# Runtime data & personal data — whole directories, never commit.
# These are the roots for everything runtime/personal: jobs.db, profile.yaml,
# the browser login profile, all run logs, scraped Boss DOM. Ignored as WHOLE
# directories on purpose: a blacklist that enumerates known subpaths (logs/runs/,
# logs/task_*/, ...) silently lets a NEW subdir slip in -- which is how the 2026-07
# leak happened (logs/task_*/ was tracked before the rule existed, and logs/final/
# was never enumerated). Anything runtime goes under one of these roots so nothing
# new can leak by omission. Content is a second line of defence (precommit_pii_scan).
code/data/
code/output/
code/logs/
/logs/
/data/
/resumes/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Node
code/dashboard/frontend/node_modules/

# TypeScript build artifacts
*.tsbuildinfo
code/dashboard/frontend/tailwind.config.d.ts
code/dashboard/frontend/tailwind.config.js
code/dashboard/frontend/vite.config.d.ts
code/dashboard/frontend/vite.config.js

# Debug / diagnostic scripts and output
code/debug_*.txt
code/debug_*.py
code/diagnose_*.txt
code/diagnose_*.py
code/verify_*.py
code/*.txt

# Factory runtime state (root /logs/ above already covers logs/factory.log,
# logs/activity.jsonl, logs/runs/, logs/task_*/, logs/orchestrator.log)
factory_state.json
code/.factory/
.codex/

# Frontend dev artifacts
code/dashboard/frontend/logs/

# Local Claude settings
.claude/

# Env / secrets
.env
*.env

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Worklog / memory (local only)
worklog.md
COLLAB.md

# Screenshots & diagnostic dumps (debug artifacts, never commit)
*.png
*_dump.json
/inspect_*.json
/tool*.json
code/memory/
code/open_boss.py

